#!/bin/bash
#SBATCH --job-name=TrimMapBatch
#SBATCH --nodes=1
#SBATCH --ntasks=4                   # 4 parallel jobs
#SBATCH --cpus-per-task=40           # 40 cores per job (4x40=160 total)
#SBATCH --mem=250G                   # memory per job (4x250=1000G total)
#SBATCH --time=24:00:00
#SBATCH --partition=delmore_lab1
#SBATCH --account=delmore_lab
#SBATCH --output=logs/%A_%a.out
#SBATCH --error=logs/%A_%a.err

# module purge
# module load anaconda3

# -----------------------------
# Configuration
# -----------------------------
BASE_DIR="/insomnia001/depts/delmore_lab/users/rwh2140/EM_seq_raw/split_reads"
REF_DIR="/insomnia001/depts/delmore_lab/users/rwh2140/puma_ref_index"  # Bismark reference
SCRIPT_DIR="/insomnia001/depts/delmore_lab/users/rwh2140/scripts/trim_map_methyl.py"
THREADS_PER_JOB=40

# List of sample subdirectories to process
SAMPLES=(
AZH055_E
AZH091_E
FE13K09_E
FE13K10_E
FE13K36_E
FE14K44_E
FE14K57_E
FE14K78_E
FE14K96_E
FE15K28_E
FE15K33_E
FE15K50_E
FG05K08_E
FG05K10_E
FG07K03_E
FG07K23_E
FG08K10_E
MB424_E
MBA267_E
ONB072_E
)

# -----------------------------
# Determine sample for this SLURM array task
# -----------------------------
SAMPLE_INDEX=$((SLURM_ARRAY_TASK_ID-1))
SAMPLE_NAME=${SAMPLES[$SAMPLE_INDEX]}
SAMPLE_DIR="$BASE_DIR/$SAMPLE_NAME"

echo "Processing sample: $SAMPLE_NAME"

# -----------------------------
# Activate Trim Galore environment
# -----------------------------
source ~/miniconda3/etc/profile.d/conda.sh
echo "Activating Trim Galore environment..."
conda activate trim_env

# Run Python script (trimming + optionally mapping if configured)
python3 "$SCRIPT_DIR" "$SAMPLE_NAME" "$SAMPLE_DIR" "$THREADS_PER_JOB" "$REF_DIR"

# -----------------------------
# Switch to Bismark environment (for alignment if needed)
# -----------------------------
echo "Switching to Bismark environment..."
conda activate bismark_env

# If alignment is not already done in Python script, you could call it here:
# Example (uncomment if needed):
# bismark -o <output_dir> $REF_DIR -1 <R1_trimmed> -2 <R2_trimmed>

echo "Finished sample: $SAMPLE_NAME"

