#!/bin/bash
#SBATCH --job-name=epi_masked_bootstrap
#SBATCH --partition=short
#SBATCH --account=delmore_lab
#SBATCH --output=logs/epi_entropy_cgi_masked_%j.out
#SBATCH --error=logs/epi_entropy_cgi_masked_%j.err
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=50
#SBATCH --mem=350G

set -euo pipefail

eval "$(conda shell.bash hook)"
conda activate puma_cpg_env

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Input files

LONG_DIR=path/to/epiallele/output/long/files/

DEPTH=/path/to/cpg_island_depths.tsv

OUT=epi_entropy_cgi_bootstrap_unmasked.tsv

NBOOT="${NBOOT:-1000}" # set number of bootstrapping rounds

SCRIPT=epi_entropy_bootstrap_cgi_V2.py


shopt -s nullglob
FILES_ARR=(${LONG_DIR}/*.combined.epiallele_long.with_ids.tsv)
shopt -u nullglob

COUNT=${#FILES_ARR[@]}

if [ "$COUNT" -eq 0 ]; then
    echo "[ERROR] no files matching ${LONG_DIR}/*.combined.epiallele_long.with_ids.tsv" >&2
    exit 1
fi


python -u "$SCRIPT" \
    "${FILES_ARR[*]}" \
    "$DEPTH" \
    "$OUT" \
    "$NBOOT" \
    2>&1 | awk '{ print strftime("[%Y-%m-%d %H:%M:%S]"), $0; fflush(); }'


