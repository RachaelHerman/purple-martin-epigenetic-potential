#!/bin/bash
#SBATCH --job-name=beta_counts_cgi
#SBATCH --partition=short
#SBATCH --account=delmore_lab
#SBATCH --output=logs/beta_counts_%j.out
#SBATCH --error=logs/beta_counts_%j.err
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G

set -euo pipefail

eval "$(conda shell.bash hook)"
conda activate puma_cpg_env

INDIR=/insomnia001/depts/delmore_lab/users/rwh2140/EM_seq_raw/bams/coord_bams/epiallele_sbatch/masked_results_combined_with_ids
OUTDIR=/insomnia001/depts/delmore_lab/users/rwh2140/EM_seq_raw/bams/coord_bams/epiallele_sbatch/masked_results_combined_with_ids/masked_cgi_beta

mkdir -p "$OUTDIR"
mkdir -p logs

shopt -s nullglob

## Files are named: {SAMPLE}.masked.name_sorted.combined.epiallele_long.with_ids.tsv
for f in "$INDIR"/*.masked.name_sorted.combined.epiallele_long.with_ids.tsv
do
    sample=$(basename "$f" .masked.name_sorted.combined.epiallele_long.with_ids.tsv)

    echo "=============================="
    echo "Processing $sample"
    echo "Input: $f"
    echo "=============================="

    python beta_epiallele_cgi.py \
        "$f" \
        "$OUTDIR/${sample}_masked_beta_counts.tsv"

done
